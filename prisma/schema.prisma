generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  password         String
  role             String       @default("student")
  fullName         String
  status           String       @default("active")
  points           Int          @default(0)
  completedModules String       // We can store this as JSON string
  quizHistory      QuizHistory[]
  labHistory       LabHistory[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model QuizHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  modulId        String
  modulTitle     String
  questionIdx    Int
  questionText   String
  selectedOption String
  correctOption  String
  isCorrect      Boolean
  createdAt      DateTime @default(now())
}

model LabHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  modulId        String
  modulTitle     String
  taskIdx        Int
  instruction    String
  typedCommand   String
  isCorrect      Boolean
  time           String
  createdAt      DateTime @default(now())
}
